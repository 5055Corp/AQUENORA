# Copy to .env.local to connect the app to the AQENORA backend (backend/ in this repo).
# Leave it unset to run the browser-only demo (that is how the GitHub Pages link is built).
VITE_API_URL=http://localhost:9000

# Needed by the public store page (store.html). The backend's demo script prints it:
#   cd backend/apps/backend && npx medusa exec ./src/scripts/seed-aqenora-demo.ts
# or find it in the admin dashboard under Settings > Publishable API keys.
VITE_MEDUSA_PUBLISHABLE_KEY=
