STORE_CORS=http://localhost:8000,https://docs.medusajs.com,http://localhost:5173,http://localhost:4173,https://5055corp.github.io
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com,https://5055corp.github.io
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
# Web addresses allowed to call the /sellers API (the AQUENORA seller app)
SELLER_CORS=http://localhost:5173,http://localhost:4173,https://5055corp.github.io

# Email campaigns. Leave RESEND_API_KEY empty locally: emails are then only logged.
RESEND_API_KEY=
EMAIL_FROM=AQUENORA <news@aquenora.com>
# Links in emails: STORE_DOMAIN once <shop>.aquenora.com works, otherwise the store page address
STORE_DOMAIN=
STORE_PAGE_URL=http://localhost:5173/store.html
# Own domains: what sellers point their domain at (set once the web server is hosted)
STORE_CNAME_TARGET=stores.aquenora.com
STORE_IP=

# First admin login, created on start if it doesn't exist (remove ADMIN_PASSWORD afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cloudflare for SaaS: sellers' own domains get HTTPS automatically (token: Zone > SSL and Certificates > Edit)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Store pictures on an S3-compatible bucket (e.g. Cloudflare R2); unset = saved in ./static
S3_BUCKET=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
